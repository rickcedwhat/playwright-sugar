{
  "name": "@rickcedwhat/playwright-sugar",
  "version": "0.3.0",
  "packageManager": "pnpm@10.33.2",
  "description": "Small Playwright helpers for QA: branching outcomes, stable fills, and flake-resistant clicks — lite snippets plus robust package exports.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "snippets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "playwright test",
    "build": "pnpm exec tsc",
    "poc": "pnpm --dir test-replacement-poc/PoC run poc",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "test:unit": "vitest run",
    "test:mutate": "pnpm exec stryker run",
    "docs:dev": "vitepress dev docs",
    "docs:dev:live": "concurrently -k -n lab,docs -c cyan,magenta \"pnpm --dir lab dev\" \"pnpm docs:dev\"",
    "docs:build": "CI=true pnpm --dir lab install --frozen-lockfile && pnpm --dir lab run build:embed && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "playwright",
    "testing",
    "qa",
    "e2e",
    "flaky",
    "helpers",
    "attemptAction",
    "relator"
  ],
  "author": "Cedrick Catalan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickcedwhat/playwright-sugar.git"
  },
  "bugs": {
    "url": "https://github.com/rickcedwhat/playwright-sugar/issues"
  },
  "homepage": "https://github.com/rickcedwhat/playwright-sugar#readme",
  "type": "module",
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.0.4",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.4"
  }
}
